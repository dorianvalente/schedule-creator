{
  "name": "Exclusion",
  "type": "object",
  "properties": {
    "agent1_id": {
      "type": "string",
      "description": "First agent in the pair that must not be scheduled together"
    },
    "agent2_id": {
      "type": "string",
      "description": "Second agent in the pair that must not be scheduled together"
    }
  },
  "required": [
    "agent1_id",
    "agent2_id"
  ],
  "rls": {
    "read": {},
