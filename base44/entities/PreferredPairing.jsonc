{
  "name": "PreferredPairing",
  "type": "object",
  "properties": {
    "agent1_id": {
      "type": "string",
      "description": "First agent in an ideal pairing"
    },
    "agent2_id": {
      "type": "string",
      "description": "Second agent in an ideal pairing"
    },
    "day": {
      "type": "string",
      "description": "Preferred ride day for this pairing. 'Any' leaves the day open",
      "enum": [
        "Any",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "default": "Any"
    }
  },
  "required": [
    "agent1_id",
    "agent2_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}