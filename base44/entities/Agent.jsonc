{
  "name": "Agent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Agent display name"
    },
    "role": {
      "type": "string",
      "description": "Tenure / role tier used for pairing",
      "enum": [
        "manager",
        "one_month",
        "sna",
        "rpa",
        "tenured",
        "veteran"
      ]
    },
    "manual_role": {
      "type": "boolean",
      "description": "When true the stored role is used as-is; otherwise tenure is calculated from the date the agent was added",
      "default": false
    },
    "team": {
      "type": "string",
      "description": "Name of the manager whose team this agent is on. Auto-assign pairs each manager with their own agents first"
    },
    "location": {
      "type": "string",
      "description": "Ride location this agent belongs to. Schedules are built one location at a time"
    },
    "contract_date": {
      "type": "string",
      "format": "date",
      "description": "Optional contract date for the agent"
    },
    "fa": {
      "type": "boolean",
      "description": "Whether this agent is marked FA",
      "default": false
    },
    "active": {
      "type": "boolean",
      "description": "Whether the agent is included in auto-assign",
      "default": true
    }
  },
  "required": [
    "name",
    "role"
  ]
}